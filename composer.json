{
    "name": "bleeding-deacons/integrity",
    "description": "Secure REST API bridge for Unity WordPress plugin - provides authenticated access to Groups and Meetings for external applications",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "The Bleeding Deacons",
            "email": "thebleedingdeacons@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "bleedingdeacons/wp-mocks": "^3.0",
        "mockery/mockery": "^1.4",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "psr/container": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Integrity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Integrity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "php build.php build:production",
        "build:production": "php build.php build:production",
        "build:dev": "php build.php build:dev",
        "build:clean": "php build.php clean",
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:coverage": "pest --coverage-html ./tests/coverage",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "stan": "@phpstan",
        "analyse": "@phpstan",
        "check": [
            "@phpcs",
            "@stan",
            "@test"
        ],
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
